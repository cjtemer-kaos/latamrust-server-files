{
  "CONFIG_VERSION_DONT_TOUCH_THIS": 3,
  "_comment": "Before changing anything, see https://github.com/Patbox/StyledChat#configuration",
  "text_formatting": {
    "legacy_formatting": true,
    "parse_links": true,
    "parse_mentions": false,
    "markdown": true,
    "respect_colors_client_setting": true
  },
  "auto_completion": {
    "tags": false,
    "tag_aliases": false,
    "emoticons": true
  },
  "default": {
    "display_name": "<clear_color>${name}</clear_color>",
    "message_formats": {
      "chat": "<gray>${player}</gray>: ${message}",
      "joined_the_game": "<yellow><lang:multiplayer.player.joined:'${player}'>",
      "joined_after_name_change": "<yellow><lang:multiplayer.player.joined.renamed:'${player}':'${old_name}'></yellow>",
      "joined_for_first_time": "<yellow><lang:multiplayer.player.joined:'${player}'></yellow>",
      "left_game": "<yellow><lang:multiplayer.player.left:'${player}'>",
      "base_death": "${default_message}",
      "advancement_task": "<lang:chat.type.advancement.task:'${player}':'${advancement}'>",
      "advancement_challenge": "<lang:chat.type.advancement.challenge:'${player}':'${advancement}'>",
      "advancement_goal": "<lang:chat.type.advancement.goal:'${player}':'${advancement}'>",
      "sent_team_chat": "<lang:'chat.type.team.sent':'<hover\\:\\'<lang\\:chat.type.team.hover>\\'><suggest_command\\:\\'/teammsg \\'>${team}':'${displayName}':'${message}'>",
      "received_team_chat": "<lang:'chat.type.team.text':'<hover\\:\\'<lang\\:chat.type.team.hover>\\'><suggest_command\\:\\'/teammsg \\'>${team}':'${displayName}':'${message}'>",
      "sent_private_message": "<gray><italic><lang:commands.message.display.outgoing:'${receiver}':'${message}'>",
      "received_private_message": "<gray><italic><lang:commands.message.display.incoming:'${sender}':'${message}'>",
      "say_command": "<red>[${player}] ${message}",
      "me_command": "<green>* ${player} ${message}",
      "pet_death": "${default_message}"
    },
    "link_style": "<underline><c:#7878ff>${link}",
    "spoiler_style": "<gray>${spoiler}",
    "spoiler_symbol": "▌",
    "formatting": {
      "dark_red": true,
      "green": true,
      "underline": true,
      "dark_green": true,
      "black": true,
      "yellow": true,
      "bold": true,
      "italic": true,
      "dark_blue": true,
      "dark_purple": true,
      "gold": true,
      "red": true,
      "aqua": true,
      "gray": true,
      "light_purple": true,
      "blue": true,
      "white": true,
      "dark_aqua": true,
      "dark_gray": true,
      "spoiler": true,
      "strikethrough": true
    },
    "emoticons": {},
    "custom_message_types": {}
  },
  "styles": [
    {
      "require": {
        "type": "permission",
        "permission": "group.admin"
      },
      "display_name": "<red><bold>ADMIN</bold></red> <rainbow><clear_color>${name}</clear_color></rainbow>",
      "message_formats": {
        "chat": "<rainbow>${player}</rainbow>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.builder"
      },
      "display_name": "<aqua><bold>BUILDER</bold></aqua> <aqua><clear_color>${name}</clear_color></aqua>",
      "message_formats": {
        "chat": "<aqua>${player}</aqua>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.staff+"
      },
      "display_name": "<gold><bold>STAFF+</bold></gold> <rainbow><clear_color>${name}</clear_color></rainbow>",
      "message_formats": {
        "chat": "<rainbow>${player}</rainbow>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.staff"
      },
      "display_name": "<blue><bold>STAFF</bold></blue> <rainbow><clear_color>${name}</clear_color></rainbow>",
      "message_formats": {
        "chat": "<rainbow>${player}</rainbow>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.streamer"
      },
      "display_name": "<light_purple><bold>STREAMER</bold></light_purple> <light_purple><clear_color>${name}</clear_color></light_purple>",
      "message_formats": {
        "chat": "<light_purple>${player}</light_purple>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.vip"
      },
      "display_name": "<green><bold>VIP</bold></green> <green><clear_color>${name}</clear_color></green>",
      "message_formats": {
        "chat": "<green>${player}</green>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.trainer"
      },
      "display_name": "<aqua><bold>TRAINER</bold></aqua> <aqua><clear_color>${name}</clear_color></aqua>",
      "message_formats": {
        "chat": "<aqua>${player}</aqua>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    },
    {
      "require": {
        "type": "permission",
        "permission": "group.default"
      },
      "display_name": "<gray><clear_color>${name}</clear_color></gray>",
      "message_formats": {
        "chat": "<gray>${player}</gray>: ${message}"
      },
      "formatting": {},
      "emoticons": {},
      "custom_message_types": {}
    }
  ]
}