{
  "config_version": 2,
  "__comment": "Before changing anything, see https://github.com/Patbox/StyledPlayerList#configuration",
  "default_style": "default",
  "messages": {
    "switch": "Your player list style has been changed to: <gold>${style}</gold>",
    "unknown": "<red>This style doesn't exist!</red>",
    "no_permission": "<red>You don't have required permissions!</red>"
  },
  "player": {
    "modify_name": true,
    "modify_right_text": false,
    "passthrough": false,
    "hidden": false,
    "format": "%player:displayname%",
    "right_text": "",
    "update_on_chat_message": false,
    "update_tick_time": -1,
    "styles": [
      {
        "require": {
          "type": "permission",
          "permission": "group.admin"
        },
        "format": "<red><bold>ADMIN</bold></red> <red>%player:displayname%</red>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.builder"
        },
        "format": "<aqua><bold>BUILDER</bold></aqua> <aqua>%player:displayname%</aqua>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.staff+"
        },
        "format": "<gold><bold>STAFF+</bold></gold> <yellow>%player:displayname%</yellow>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.staff"
        },
        "format": "<aqua><bold>STAFF</bold></aqua> <aqua>%player:displayname%</aqua>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.vipx"
        },
        "format": "<gold><bold>VIPX</bold></gold> <gold>%player:displayname%</gold>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.vip"
        },
        "format": "<green><bold>VIP</bold></green> <green>%player:displayname%</green>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.trainer"
        },
        "format": "<aqua><bold>TRAINER</bold></aqua> <aqua>%player:displayname%</aqua>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.jugador"
        },
        "format": "<dark_gray><bold>JUGADOR</bold></dark_gray> <gray>%player:displayname%</gray>",
        "passthrough": false
      },
      {
        "require": {
          "type": "permission",
          "permission": "group.default"
        },
        "format": "<gray>?</gray> <dark_gray>%player:displayname%</dark_gray>",
        "passthrough": false
      }
    ]
  },
  "client_show_in_singleplayer": true
}